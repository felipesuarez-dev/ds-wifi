[Unit]
Description=DS WiFi Wiimmfi stats scraper
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ds-wifi/scraper
Environment=HOME=/opt/ds-wifi/scraper
Environment=PUPPETEER_CACHE_DIR=/opt/ds-wifi/scraper/.cache
Environment=TMPDIR=/tmp
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x800x24" /usr/local/bin/node /opt/ds-wifi/scraper/scraper.js
Restart=always
RestartSec=30
KillMode=mixed
TimeoutStopSec=20
FinalKillSignal=SIGKILL

[Install]
WantedBy=multi-user.target
